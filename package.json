{
  "name": "home-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm exec prisma generate",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate": "pnpm exec prisma migrate dev",
    "prisma:deploy": "pnpm exec prisma migrate deploy",
    "seed:planner": "tsx scripts/seed-task-planner.ts",
    "seed:shop": "tsx scripts/seed-shop.ts",
    "news:refresh": "tsx scripts/refresh-news.ts",
    "news:fetch": "curl -X POST http://localhost:3000/api/fetch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "better-sqlite3": "^12.6.2",
    "googleapis": "^148.0.0",
    "next": "^15.2.0",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss-parser": "^3.13.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
