generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NewsItem {
  id          String   @id @default(cuid())
  feedUrl     String
  title       String
  url         String
  summary     String?
  publishedAt DateTime?
  dedupHash   String   @unique
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  startAt   DateTime
  endAt     DateTime
  tag       String
  fatigue   Int
  source    String
  createdAt DateTime @default(now())

  @@index([startAt])
  @@index([title, startAt])
}

model Task {
  id             String   @id @default(cuid())
  title          String
  note           String?
  minutes        Int
  progressMinutes Int     @default(0)
  canSplit       Boolean  @default(true)
  importance     Int
  fatigue        Int
  urgency        Int      @default(3)
  dueDate        DateTime?
  targetDate     DateTime?
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([targetDate])
}

model InventoryItem {
  id                   String         @id @default(cuid())
  name                 String
  category             String?
  location             String?
  unit                 String
  currentQuantity      Float          @default(0)
  minimumQuantity      Float          @default(0)
  preferredBuyQuantity Float          @default(1)
  note                 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  shoppingItems        ShoppingItem[]

  @@index([name])
  @@index([category])
  @@index([location])
}

model ShoppingItem {
  id              String         @id @default(cuid())
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  name            String
  quantity        Float          @default(1)
  unit            String
  status          String
  store           String?
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  purchasedAt     DateTime?

  @@index([status])
  @@index([inventoryItemId])
  @@index([createdAt])
}
