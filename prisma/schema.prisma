generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NewsItem {
  id          String    @id @default(cuid())
  feedUrl     String
  title       String
  url         String
  summary     String?
  publishedAt DateTime?
  dedupHash   String    @unique
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  startAt   DateTime
  endAt     DateTime
  tag       String
  fatigue   Int
  source    String
  createdAt DateTime @default(now())

  @@index([startAt])
  @@index([title, startAt])
}

model Task {
  id              String    @id @default(cuid())
  title           String
  note            String?
  minutes         Int
  progressMinutes Int       @default(0)
  canSplit        Boolean   @default(true)
  importance      Int
  fatigue         Int
  urgency         Int       @default(3)
  dueDate         DateTime?
  targetDate      DateTime?
  status          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([targetDate])
}

model InventoryItem {
  id                   String         @id @default(cuid())
  name                 String
  category             String?
  location             String?
  unit                 String
  currentQuantity      Float          @default(0)
  minimumQuantity      Float          @default(0)
  preferredBuyQuantity Float          @default(1)
  note                 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  shoppingItems        ShoppingItem[]

  @@index([name])
  @@index([category])
  @@index([location])
}

model ShoppingItem {
  id              String         @id @default(cuid())
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  name            String
  quantity        Float          @default(1)
  unit            String
  status          String
  store           String?
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  purchasedAt     DateTime?

  @@index([status])
  @@index([inventoryItemId])
  @@index([createdAt])
}

model JobSite {
  id           String   @id @default(cuid())
  name         String
  url          String
  purpose      String
  loginId      String
  password     String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([name])
}

model JobCompany {
  id           String   @id @default(cuid())
  companyName  String
  myPageUrl    String
  loginId      String
  password     String
  storagePath  String?
  status       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  essays       JobEssay[]
  submissions  JobSubmission[]
  timelines    JobTimeline[]
  usefulLinks  JobUsefulLink[]

  @@index([displayOrder])
  @@index([companyName])
  @@index([status])
}

model JobEssay {
  id          String     @id @default(cuid())
  companyId   String
  company     JobCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  submittedAt DateTime?
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId, createdAt])
}

model JobSubmission {
  id          String     @id @default(cuid())
  companyId   String
  company     JobCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemType    String
  status      String
  submittedAt DateTime?
  storagePath String?
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId, createdAt])
  @@index([status])
}

model JobTimeline {
  id          String     @id @default(cuid())
  companyId   String
  company     JobCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  eventDate   DateTime
  status      String
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId, eventDate])
  @@index([status])
}

model JobUsefulLink {
  id        String     @id @default(cuid())
  companyId String
  company   JobCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  url       String
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([companyId, createdAt])
}

model OrganizerTask {
  id               String               @id @default(cuid())
  title            String
  description      String?
  category         String
  status           String               @default("inbox")
  importance       Int                  @default(2)
  estimatedMinutes Int?
  targetDate       String?
  dueDate          String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  completedAt      DateTime?
  timeBlocks       OrganizerTimeBlock[]

  @@index([status])
  @@index([targetDate])
  @@index([dueDate])
  @@index([category, status])
}

model OrganizerEvent {
  id                     String    @id @default(cuid())
  title                  String
  description            String?
  category               String
  startAt                DateTime
  endAt                  DateTime
  allDay                 Boolean   @default(false)
  location               String?
  shareWithPartner       Boolean   @default(false)
  googleCalendarId       String?
  googleCalendarEventId  String?
  googleEtag             String?
  googleUpdatedAt        DateTime?
  googleSyncStatus       String    @default("local_only")
  lastSyncedAt           DateTime?
  lastSyncedHash         String?
  eventTimeZone          String?
  googleRecurringEventId String?
  originalStartTime      DateTime?
  originalStartDate      String?
  googleEventType        String?
  googleStatus           String?
  recurrenceJson         String?
  startDate              String?
  endDateExclusive       String?
  timetreeEventId        String?   @unique
  timetreeSyncStatus     String    @default("not_requested")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([googleCalendarId, googleCalendarEventId])
  @@index([startAt])
  @@index([endAt])
  @@index([startAt, endAt])
  @@index([shareWithPartner, timetreeSyncStatus])
  @@index([googleCalendarId, googleSyncStatus])
}

model GoogleCalendarMapping {
  id                String    @id @default(cuid())
  category          String    @unique
  googleCalendarId  String    @unique
  displayName       String
  accessRole        String
  timeZone          String?
  enabled           Boolean   @default(true)
  importCompletedAt DateTime?
  outboundEnabledAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model GoogleCalendarSyncCursor {
  id               String    @id @default(cuid())
  googleCalendarId String    @unique
  syncToken        String
  lastFullSyncAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model GoogleCalendarSyncRun {
  id                    String                          @id @default(cuid())
  mode                  String
  status                String
  startedAt             DateTime                        @default(now())
  finishedAt            DateTime?
  previewExpiresAt      DateTime?
  confirmationTokenHash String?
  fingerprint           String?
  summaryJson           String
  blockingIssueCount    Int                             @default(0)
  googleWriteCount      Int                             @default(0)
  errorMessage          String?
  calendars             GoogleCalendarSyncRunCalendar[]
  items                 GoogleCalendarImportItem[]

  @@index([startedAt])
  @@index([status])
}

model GoogleCalendarSyncRunCalendar {
  id               String                @id @default(cuid())
  runId            String
  googleCalendarId String
  category         String
  displayName      String
  fetched          Int                   @default(0)
  created          Int                   @default(0)
  updated          Int                   @default(0)
  skipped          Int                   @default(0)
  warnings         Int                   @default(0)
  errors           Int                   @default(0)
  pages            Int                   @default(0)
  nextSyncToken    String?
  run              GoogleCalendarSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, googleCalendarId])
  @@index([googleCalendarId])
}

model GoogleCalendarImportItem {
  id                 String                @id @default(cuid())
  runId              String
  googleCalendarId   String
  googleEventId      String
  action             String
  severity           String
  payloadJson        String
  payloadHash        String
  duplicateCandidate Boolean               @default(false)
  run                GoogleCalendarSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, googleCalendarId, googleEventId])
  @@index([googleCalendarId, googleEventId])
}

model OrganizerTimeBlock {
  id            String        @id @default(cuid())
  taskId        String
  title         String
  startAt       DateTime
  endAt         DateTime
  status        String        @default("planned")
  actualStartAt DateTime?
  actualEndAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  task          OrganizerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([startAt])
  @@index([endAt])
  @@index([taskId, startAt])
}

model OrganizerRoutine {
  id               String                       @id @default(cuid())
  title            String
  category         String
  estimatedMinutes Int
  daysOfWeek       String
  active           Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  completions      OrganizerRoutineCompletion[]

  @@index([active])
  @@index([category, active])
}

model OrganizerRoutineCompletion {
  id          String           @id @default(cuid())
  routineId   String
  date        String
  completedAt DateTime         @default(now())
  routine     OrganizerRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@index([date])
  @@index([routineId, date])
}
