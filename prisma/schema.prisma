generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NewsItem {
  id          String   @id @default(cuid())
  feedUrl     String
  title       String
  url         String
  summary     String?
  publishedAt DateTime?
  dedupHash   String   @unique
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  startAt   DateTime
  endAt     DateTime
  tag       String
  fatigue   Int
  source    String
  createdAt DateTime @default(now())

  @@index([startAt])
  @@index([title, startAt])
}

model Task {
  id         String   @id @default(cuid())
  title      String
  note       String?
  minutes    Int
  importance Int
  fatigue    Int
  dueDate    DateTime?
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
}
