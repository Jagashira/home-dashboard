generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NewsItem {
  id          String   @id @default(cuid())
  feedUrl     String
  title       String
  url         String
  summary     String?
  publishedAt DateTime?
  dedupHash   String   @unique
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  startAt   DateTime
  endAt     DateTime
  tag       String
  fatigue   Int
  source    String
  createdAt DateTime @default(now())

  @@index([startAt])
  @@index([title, startAt])
}

model Task {
  id             String   @id @default(cuid())
  title          String
  note           String?
  minutes        Int
  progressMinutes Int     @default(0)
  canSplit       Boolean  @default(true)
  importance     Int
  fatigue        Int
  urgency        Int      @default(3)
  dueDate        DateTime?
  targetDate     DateTime?
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([targetDate])
}

model InventoryItem {
  id                   String         @id @default(cuid())
  name                 String
  category             String?
  location             String?
  unit                 String
  currentQuantity      Float          @default(0)
  minimumQuantity      Float          @default(0)
  preferredBuyQuantity Float          @default(1)
  note                 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  shoppingItems        ShoppingItem[]

  @@index([name])
  @@index([category])
  @@index([location])
}

model ShoppingItem {
  id              String         @id @default(cuid())
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  name            String
  quantity        Float          @default(1)
  unit            String
  status          String
  store           String?
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  purchasedAt     DateTime?

  @@index([status])
  @@index([inventoryItemId])
  @@index([createdAt])
}

model JobSite {
  id           String   @id @default(cuid())
  name         String
  url          String
  purpose      String
  loginId      String
  password     String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([name])
}

model JobCompany {
  id           String   @id @default(cuid())
  companyName  String
  myPageUrl    String
  loginId      String
  password     String
  status       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  essays       JobEssay[]
  submissions  JobSubmission[]
  timelines    JobTimeline[]
  usefulLinks  JobUsefulLink[]

  @@index([displayOrder])
  @@index([companyName])
  @@index([status])
}

model JobEssay {
  id          String     @id @default(cuid())
  companyId   String
  company     JobCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  submittedAt DateTime?
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId, createdAt])
}

model JobSubmission {
  id          String     @id @default(cuid())
  companyId   String
  company     JobCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemType    String
  status      String
  submittedAt DateTime?
  storagePath String?
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId, createdAt])
  @@index([status])
}

model JobTimeline {
  id          String     @id @default(cuid())
  companyId   String
  company     JobCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  eventDate   DateTime
  status      String
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId, eventDate])
  @@index([status])
}

model JobUsefulLink {
  id        String     @id @default(cuid())
  companyId String
  company   JobCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  url       String
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([companyId, createdAt])
}
