generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NewsItem {
  id          String   @id @default(cuid())
  feedUrl     String
  title       String
  url         String
  summary     String?
  publishedAt DateTime?
  dedupHash   String   @unique
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
